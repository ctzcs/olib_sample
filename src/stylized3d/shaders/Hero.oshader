// 角色：被墙挡住的部分画成纯色剪影（ZTest Greater、不写深度），可见部分正常着色。
// 游戏按 场景 → silhouette → body 的顺序分别提交：剪影要在遮挡物写完深度之后、本体写深度之前画，
// 否则会叠到角色自己被挡住的部位上。
Shader "Hero"
{
    Label "stylized3d / Hero"
    Preview 3D
    Output "color"
    Properties
    {
        _color ("Color", Color) = (0.86,0.27,0.32,1)
        _silhouette ("Silhouette", Color) = (0.36,0.56,1,1)
    }

    Pass "silhouette"
    {
        Label "Silhouette"
        Draw Model
        Cull Back
        Blend Opaque
        ZTest Greater
        ZWrite Off
        HLSLPROGRAM
        #include "Stylized.hlsli"
        float4 vertex_main(MeshInput v) : SV_Position { return mul(float4(v.Position, 1), Wvp); }
        float4 fragment_main() : SV_Target0 { return _silhouette; }
        ENDHLSL
    }

    Pass "body"
    {
        Label "Body"
        Draw Model
        Cull Back
        Blend Opaque
        ZTest Less
        ZWrite On
        HLSLPROGRAM
        #include "Stylized.hlsli"
        struct Output { float4 Position : SV_Position; float3 Normal : TEXCOORD0; float3 World : TEXCOORD1; };
        Output vertex_main(MeshInput v)
        {
            Output o;
            o.Position = mul(float4(v.Position, 1), Wvp);
            o.Normal = mul(v.Normal, (float3x3)World);
            o.World = mul(float4(v.Position, 1), World).xyz;
            return o;
        }
        float4 fragment_main(Output v) : SV_Target0
        {
            return float4(stylized_shade(_color.rgb * Tint.rgb, v.Normal, v.World), 1);
        }
        ENDHLSL
    }
}

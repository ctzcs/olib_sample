// 天空：以相机为中心的大球，从内侧画（Cull Front），不测也不写深度，最先单独提交。
// 太阳方向来自视图块，所以太阳圆盘与地面受光一致。
Shader "Sky"
{
    Label "stylized3d / Sky"
    Preview 3D
    Output "color"
    Properties
    {
        _zenith ("Zenith", Color) = (0.35,0.62,0.73,1)
        // 地平线颜色与 main.odin 的雾色相同，远处地面融进天空。
        _horizon ("Horizon", Color) = (0.91,0.89,0.73,1)
    }

    Pass "sky"
    {
        Label "Sky"
        Draw Model
        Cull Front
        Blend Opaque
        ZTest Off
        ZWrite Off
        HLSLPROGRAM
        #include "Stylized.hlsli"
        struct Output { float4 Position : SV_Position; float3 Direction : TEXCOORD0; };
        Output vertex_main(MeshInput v)
        {
            Output o;
            o.Position = mul(float4(v.Position, 1), Wvp);
            o.Direction = v.Position; // 单位球：顶点位置就是视线方向
            return o;
        }
        float4 fragment_main(Output v) : SV_Target0
        {
            SceneView view = scene_view(FragmentView);
            float3 direction = normalize(v.Direction);
            float3 color = lerp(_horizon.rgb, _zenith.rgb, saturate(direction.y * 1.6));
            float sun = smoothstep(0.9965, 0.9985, dot(direction, -view.sun_direction.xyz));
            return float4(color + view.sun_color.rgb * sun, 1);
        }
        ENDHLSL
    }
}

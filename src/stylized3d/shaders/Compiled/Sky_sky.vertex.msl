#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_MatrixBlock
{
    float4x4 Wvp;
    float4x4 World;
    float4 VertexClock;
    float4 VertexCamera;
};

struct vertex_main_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_MatrixBlock& MatrixBlock [[buffer(0)]])
{
    vertex_main_out out = {};
    out.gl_Position = float4(in.in_var_TEXCOORD0, 1.0) * MatrixBlock.Wvp;
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD0;
    return out;
}


#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_MatrixBlock
{
    float4x4 Wvp;
    float4x4 World;
    float4 VertexClock;
    float4 VertexCamera;
};

struct vertex_main_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float3 out_var_TEXCOORD1 [[user(locn1)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_MatrixBlock& MatrixBlock [[buffer(0)]])
{
    vertex_main_out out = {};
    float4 _31 = float4(in.in_var_TEXCOORD0, 1.0);
    out.gl_Position = _31 * MatrixBlock.Wvp;
    out.out_var_TEXCOORD0 = float3x3(float4(MatrixBlock.World[0][0], MatrixBlock.World[1][0], MatrixBlock.World[2][0], MatrixBlock.World[3][0]).xyz, float4(MatrixBlock.World[0][1], MatrixBlock.World[1][1], MatrixBlock.World[2][1], MatrixBlock.World[3][1]).xyz, float4(MatrixBlock.World[0][2], MatrixBlock.World[1][2], MatrixBlock.World[2][2], MatrixBlock.World[3][2]).xyz) * in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = (_31 * MatrixBlock.World).xyz;
    return out;
}


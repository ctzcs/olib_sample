#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_ViewBlock
{
    float4x4 Projection;
    float4 VertexClock;
};

struct vertex_main_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_ViewBlock& ViewBlock [[buffer(0)]])
{
    vertex_main_out out = {};
    out.gl_Position = ViewBlock.Projection * float4(in.in_var_TEXCOORD0, 0.0, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    return out;
}


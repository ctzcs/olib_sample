#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_MatrixBlock
{
    float4x4 Wvp;
    float4x4 World;
    float4 VertexClock;
    float4 VertexCamera;
};

struct vertex_main_out
{
    float4 out_var_TEXCOORD8 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float4 in_var_TEXCOORD6 [[attribute(0)]];
    float4 in_var_TEXCOORD7 [[attribute(1)]];
    float4 in_var_TEXCOORD8 [[attribute(2)]];
    float4 in_var_TEXCOORD9 [[attribute(3)]];
    float4 in_var_TEXCOORD10 [[attribute(4)]];
    float3 in_var_TEXCOORD0 [[attribute(5)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_MatrixBlock& MatrixBlock [[buffer(0)]])
{
    vertex_main_out out = {};
    out.gl_Position = float4((transpose(float4x4(in.in_var_TEXCOORD6, in.in_var_TEXCOORD7, in.in_var_TEXCOORD8, in.in_var_TEXCOORD9)) * float4(in.in_var_TEXCOORD0, 1.0)).xyz, 1.0) * MatrixBlock.Wvp;
    out.out_var_TEXCOORD8 = in.in_var_TEXCOORD10;
    return out;
}


#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_MaterialParams
{
    float4 _olib_param_0;
};

struct SceneView
{
    float4 sun_direction;
    float4 sun_color;
    float4 shadow;
    float4 fog_color;
    float4 fog;
    float4 camera_right;
    float4 camera_up;
    float4 light_c0;
    float4 light_c1;
    float4 light_c2;
    float4 light_c3;
    float4 shadow_map;
    float4 reflection_c0;
    float4 reflection_c1;
    float4 reflection_c2;
    float4 reflection_c3;
    float4 water_view;
};

struct type_FragmentViewBlock
{
    SceneView FragmentView;
};

struct fragment_main_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct fragment_main_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
    float4 in_var_TEXCOORD8 [[user(locn1), flat]];
};

fragment fragment_main_out fragment_main(fragment_main_in in [[stage_in]], constant type_MaterialParams& MaterialParams [[buffer(1)]], constant type_FragmentViewBlock& FragmentViewBlock [[buffer(2)]])
{
    fragment_main_out out = {};
    if (FragmentViewBlock.FragmentView.water_view.y > 0.5)
    {
        discard_fragment();
    }
    out.out_var_SV_Target0 = float4(select(FragmentViewBlock.FragmentView.shadow, float4(0.1599999964237213134765625, 0.20000000298023223876953125, 0.4199999868869781494140625, 0.550000011920928955078125), bool4(FragmentViewBlock.FragmentView.sun_color.w == 0.0)).xyz * 0.550000011920928955078125, (1.0 - smoothstep(1.0 - MaterialParams._olib_param_0.x, 1.0, length(in.in_var_TEXCOORD0))) * in.in_var_TEXCOORD8.w);
    return out;
}


#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Matrices
{
    float4x4 WorldViewProjection;
    float4x4 World;
};

struct vertex_main_out
{
    float3 out_var_TEXCOORD0 [[user(locn0)]];
    float2 out_var_TEXCOORD1 [[user(locn1)]];
    float4 out_var_TEXCOORD2 [[user(locn2)]];
    float4 gl_Position [[position]];
};

struct vertex_main_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float3 in_var_TEXCOORD1 [[attribute(1)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
    float4 in_var_TEXCOORD3 [[attribute(3)]];
};

vertex vertex_main_out vertex_main(vertex_main_in in [[stage_in]], constant type_Matrices& Matrices [[buffer(0)]])
{
    vertex_main_out out = {};
    out.gl_Position = float4(in.in_var_TEXCOORD0, 1.0) * Matrices.WorldViewProjection;
    out.out_var_TEXCOORD0 = float3x3(float4(Matrices.World[0][0], Matrices.World[1][0], Matrices.World[2][0], Matrices.World[3][0]).xyz, float4(Matrices.World[0][1], Matrices.World[1][1], Matrices.World[2][1], Matrices.World[3][1]).xyz, float4(Matrices.World[0][2], Matrices.World[1][2], Matrices.World[2][2], Matrices.World[3][2]).xyz) * in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD3;
    return out;
}


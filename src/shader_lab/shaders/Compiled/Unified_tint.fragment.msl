#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_MaterialParams
{
    float4 _olib_param_0;
    float4 _olib_param_1;
    float4 _olib_param_2;
};

struct fragment_main_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct fragment_main_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment fragment_main_out fragment_main(fragment_main_in in [[stage_in]], constant type_MaterialParams& MaterialParams [[buffer(1)]], texture2d<float> _Source [[texture(0)]], sampler _SourceSampler [[sampler(0)]])
{
    fragment_main_out out = {};
    out.out_var_SV_Target0 = float4(_Source.sample(_SourceSampler, in.in_var_TEXCOORD0).xyz * MaterialParams._olib_param_2.xyz, 1.0);
    return out;
}


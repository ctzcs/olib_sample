// 大批量实例化的模型：每个实例的世界矩阵、tint、hue 和运动参数都来自常驻实例缓冲，
// 一次 Draw 画出全部实例。缓冲加载后不再改写：每帧的运动由顶点着色器按 Clock 计算，
// CPU 只传时间。顶点接口见 olib kit/rendering/shader/lang 的 instanced 约定。
Shader "Swarm"
{
    Label "模型实例化 / 大批量"
    Preview 3D
    Output "color"
    Properties
    {
        [Instance] _hue ("Hue", Range(0,1)) = 0.15
        // x 相位（弧度）、y 角速度（弧度/秒）、z 环绕半径（世界单位）
        [Instance] _motion ("Motion", Vector3(0,7)) = (0,1,0.15)
    }

    Pass "body"
    {
        Label "本体"
        Draw Model
        Cull Back
        Blend Opaque
        ZTest Less
        ZWrite On
        Target { Clear (0.12,0.15,0.20,1) }
        HLSLPROGRAM
        #include "Palette.hlsli"
        // 引擎块：instanced 时 World 为单位矩阵、Wvp 即 ViewProjection，世界矩阵来自实例；顶点侧时间是 VertexClock。
        #include "olib/model.hlsli"
        // OlibInstanceInput 必须是第一个成员；网格属性随后依次声明。
        struct Input {
            OlibInstanceInput Instance;
            float3 Position : TEXCOORD0;
            float3 Normal : TEXCOORD1;
            float2 Uv : TEXCOORD2;
            float4 Tangent : TEXCOORD3;
        };
        // 传给片元的变量必须全部在片元里被使用，否则 D3D12 的阶段接口对不上、管线创建失败。
        struct Output {
            float4 Position : SV_Position;
            float3 Normal : TEXCOORD0;
            OlibInstance Instance;
        };
        Output vertex_main(Input v)
        {
            Output o;
            olib_instance = olib_instance_from(v.Instance);
            float4x4 world = olib_world(v.Instance);
            // 每个实例绕自己的静止位置转圈并上下起伏；相位、速度、半径各不相同，所以全部都在动。
            float t = VertexClock.x * _motion.y + _motion.x;
            float3 offset = float3(cos(t), 0.6 * sin(t * 1.7), sin(t)) * _motion.z;
            float4 position = mul(float4(v.Position, 1), world);
            position.xyz += offset;
            o.Position = mul(position, Wvp);
            o.Normal = mul(v.Normal, (float3x3)world);
            o.Instance = olib_instance;
            return o;
        }
        float4 fragment_main(Output v) : SV_Target0
        {
            olib_instance = v.Instance;
            float light = 0.25 + 0.75 * saturate(dot(normalize(v.Normal), normalize(float3(-0.5, 0.8, 0.6))));
            float3 color = palette(_hue + Clock.x * 0.05) * InstanceTint.rgb;
            return float4(color * light, InstanceTint.a);
        }
        ENDHLSL
    }
}

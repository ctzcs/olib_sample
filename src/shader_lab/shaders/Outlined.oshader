// 参数、Pass 和 HLSL 在同一文件编辑。
Shader "Outlined"
{
    Label "模型材质 / 本体 + 描边"
    Preview 3D
    Output "color"
    Properties
    {
        _strength ("Strength", Range(0,1)) = 0.65
        _hue ("Hue", Range(0,1)) = 0.15
        [Step(0.1)] _speed ("Flow speed", Range(0,5)) = 2
        _tint ("Tint", Color) = (1,1,1,1)
        _image ("Texture", 2D) = ""
        _color ("Outline color", Color) = (0.03,0.04,0.07,1)
    }

    Pass "body"
    {
        Label "本体"
        Draw Model
        Cull Back
        Blend Opaque
        ZTest Less
        ZWrite On
        Target { Clear (0.12,0.15,0.20,1) }
        HLSLPROGRAM
        #include "Palette.hlsli"
        // Vertex b0: matrices. Fragment b0: engine inputs; b1/textures: generated parameters.
        cbuffer MatrixBlock : register(b0, space1) { float4x4 Wvp; float4x4 World; };
        cbuffer PreviewBlock : register(b0, space3) {
            float4 Clock;
            float4 Pointer;
            float4 Tint;
        };
        struct Input {
            float3 Position : TEXCOORD0;
            float3 Normal : TEXCOORD1;
            float2 Uv : TEXCOORD2;
            float4 Tangent : TEXCOORD3;
        };
        struct Output {
            float4 Position : SV_Position;
            float3 Normal : TEXCOORD0;
            float2 Uv : TEXCOORD1;
        };
        Output vertex_main(Input v)
        {
            Output o;
            o.Position = mul(float4(v.Position, 1), Wvp);
            o.Normal = mul(v.Normal, (float3x3)World);
            o.Uv = v.Uv;
            return o;
        }
        float4 fragment_main(Output v) : SV_Target0
        {
            float light = 0.18 + 0.82 * saturate(dot(normalize(v.Normal), normalize(float3(-0.5, 0.8, 0.6))));
            float ripple = sin(v.Uv.y * 28 + Clock.x * _speed) * _strength * 0.1;
            float3 color = palette(v.Uv.y + _hue + ripple) * _tint.rgb;
            float3 tex = _image.Sample(_imageSampler, v.Uv).rgb;
            return float4(color * light * lerp(float3(1, 1, 1), tex, 0.2) * _tint.a, _tint.a);
        }
        ENDHLSL
    }

    Pass "outline"
    {
        Label "描边"
        Draw Model
        Cull Front
        Blend Opaque
        ZTest Less_Equal
        ZWrite Off
        Target { Clear (0.12,0.15,0.20,1) }
        HLSLPROGRAM
cbuffer MatrixBlock : register(b0, space1) { float4x4 Wvp; float4x4 World; };
struct Input {
    float3 Position : TEXCOORD0;
    float3 Normal : TEXCOORD1;
    float2 Uv : TEXCOORD2;
    float4 Tangent : TEXCOORD3;
};
float4 vertex_main(Input v) : SV_Position
{
    // Object-space thickness; edit this constant live in Shader Lab.
    return mul(float4(v.Position + v.Normal * 0.055, 1), Wvp);
}
float4 fragment_main() : SV_Target0 { return _color; }
        ENDHLSL
    }
}

// 单文件示例：参数、共享代码、两个 Pass 和目标连线。
Shader "Unified"
{
	Label "Single-file / rings + tint"
	Preview 2D
	Output "color"

	Properties
	{
		_Speed ("Speed", Range(0, 5)) = 1
		_Strength ("Strength", Range(0, 1)) = 0.65
		_Tint ("Tint", Color) = (0.2, 0.65, 1, 1)
		_Source ("Source", 2D) = ""
	}

	HLSLINCLUDE
	#include "olib/fullscreen.hlsli"
	struct Input { float2 Position : TEXCOORD0; float2 Uv : TEXCOORD1; };
	struct Output { float4 Position : SV_Position; float2 Uv : TEXCOORD0; };
	Output vertex_main(Input v)
	{
		Output o;
		o.Position = float4(v.Position * View.xy, 0, 1);
		o.Uv = v.Uv;
		return o;
	}
	ENDHLSL

	Pass "rings"
	{
		Label "Rings"
		Draw Fullscreen
		Output "rings"
		Target { Scale 0.5 Format Float16 }

		HLSLPROGRAM
		float4 fragment_main(Output v) : SV_Target0
		{
			float2 p = (v.Uv - 0.5) * float2(Pointer.z / max(Pointer.w, 1), 1);
			float rings = 0.5 + 0.5 * cos(length(p) * 35 - Clock.x * _Speed);
			float light = lerp(0.2, rings, _Strength);
			return float4(light.xxx, 1);
		}
		ENDHLSL
	}

	Pass "tint"
	{
		Label "Tint"
		Draw Fullscreen
		Blend Opaque
		Output "color"
		Input _Source "rings" Current

		HLSLPROGRAM
		float4 fragment_main(Output v) : SV_Target0
		{
			float3 rings = _Source.Sample(_SourceSampler, v.Uv).rgb;
			return float4(rings * _Tint.rgb, 1);
		}
		ENDHLSL
	}
}
